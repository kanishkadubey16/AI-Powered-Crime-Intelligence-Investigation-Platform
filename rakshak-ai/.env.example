# ─────────────────────────────────────────────────────────────────────────────
# Rakshak AI — Environment Variables
# Copy this file to .env and fill in your values before running docker compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Option A: Use the MongoDB container (default — leave blank or comment out)
# MONGODB_URI=mongodb://mongodb:27017/rakshak-ai

# Option B: Use MongoDB Atlas (recommended for production)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rakshak-ai?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
